    <!-- About Section Strings -->
    <string name="about_uniswap_title">About UniSwap</string>
    <string name="about_tagline">The Verified Peer-to-Peer Campus Marketplace</string>
    <string name="about_version">Version %1$s • Production Build</string>
    <string name="about_version_pill">v%1$s</string>
    <string name="about_section_mission_title">Our Mission</string>
    <string name="about_section_mission_body">UniSwap empowers university students to buy, sell, and give away textbooks, electronics, dorm essentials, and study notes safely within their verified campus community while actively reducing campus waste.</string>
    <string name="about_section_guidelines_title">Community &amp; Safety Guidelines</string>
    <string name="about_rule_1_title">Verified Student Community</string>
    <string name="about_rule_1_body">Listings and direct chats are exclusive to verified college students to maintain trust and prevent scams.</string>
    <string name="about_rule_2_title">Public Campus Meetups</string>
    <string name="about_rule_2_body">Exchanges should take place in well-lit, high-traffic public spots such as the Library, Student Center, or Cafeteria.</string>
    <string name="about_rule_3_title">Prohibited &amp; Restricted Items</string>
    <string name="about_rule_3_body">No hazardous materials, graded exam materials, weapons, or policy-violating goods are permitted on campus.</string>
    <string name="about_rule_4_title">Zero Middleman Fees</string>
    <string name="about_rule_4_body">100% free peer-to-peer exchanges with direct UPI/cash settlement at the time of pickup.</string>

    <!-- Help Center & FAQ Strings -->
    <string name="faq_cat_all">All</string>
    <string name="faq_cat_safety">Safety &amp; Verification</string>
    <string name="faq_cat_trading">Buying &amp; Selling</string>
    <string name="faq_cat_meetups">Meetups &amp; Pickup</string>
    <string name="faq_cat_account">Account &amp; Impact</string>

    <string name="faq_q1">How do I get the Verified Student badge?</string>
    <string name="faq_a1">Verify your account using your official university (.edu or college domain) email. Once verified, a green badge appears on your profile and listings.</string>

    <string name="faq_q2">Where is the safest place on campus to meet?</string>
    <string name="faq_a2">Always arrange meetups during daylight hours in public, high-footfall spots like the University Library lobby, Student Union, or campus cafeterias. Avoid private dorm rooms or off-campus alleys.</string>

    <string name="faq_q3">How do payments work on UniSwap?</string>
    <string name="faq_a3">UniSwap facilitates direct peer-to-peer transactions without platform cuts. Pay directly using UPI (Google Pay, PhonePe, Paytm) or cash during your in-person meetup after inspecting the item.</string>

    <string name="faq_q4">How do I mark an item as Sold or Given Away?</string>
    <string name="faq_a4">Go to your Profile tab, find the item under \'Selling\', tap the 3-dot menu, and select \'Mark as Sold / Given\'. This updates your status and increments your campus recycled count.</string>

    <string name="faq_q5">How do I block or report a suspicious user or listing?</string>
    <string name="faq_a5">Long-press any listing card on the feed or tap the 3-dot action menu to select \'Report Listing\' or \'Block User\'. You can monitor submitted reports under Settings -> Privacy &amp; Safety -> My Reports.</string>

    <string name="faq_q6">How is my \'Lbs of Waste Saved\' calculated?</string>
    <string name="faq_a6">Every item you successfully give away or sell instead of trashing keeps approx. 2.5 lbs of usable materials out of the landfill, which is reflected directly on your profile impact card.</string>

    <string name="faq_q7">Can I list items for free as a giveaway?</string>
    <string name="faq_a7">Yes! In the \'Sell\' screen, enter ₹0 or tap \'Give for Free\'. Your item will be tagged with a distinct green FREE badge on campus feeds.</string>

    <string name="faq_q8">Can I change my registered Campus Center?</string>
    <string name="faq_a8">Yes. Navigate to Settings, tap \'Campus Center\' under the Account section, and pick your university campus from the list.</string>

