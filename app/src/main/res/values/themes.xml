<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.UniSwap" parent="android:Theme.Material.Light.NoActionBar">
        <!-- We handle everything else in Compose Theme.kt -->
    </style>

    <!-- Splash Screen Theme (Android 12+) -->
    <style name="Theme.UniSwap.Splash" parent="Theme.SplashScreen">
        <!-- Background color matching app background (Pure Black) -->
        <item name="windowSplashScreenBackground">#000000</item>

        <!-- Centered aspect-ratio preserved drawables -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage" tools:targetApi="31">@drawable/splash_branding</item>

        <!-- Theme to switch to AFTER splash is dismissed -->
        <item name="postSplashScreenTheme">@style/Theme.UniSwap</item>
    </style>
</resources>